{
  "name": "ui-extension",
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "main": "./dist/alecUiExtension.umd.js",
  "module": "./dist/alecUiExtension.es.js",
  "exports": {
    ".": {
      "import": "./dist/alecUiExtension.es.js",
      "require": "./dist/alecUiExtension.umd.js"
    }
  },
  "scripts": {
    "dev": "vite --config vite.config.dev.ts",
    "build": "vue-tsc --noEmit && vite build && cp dist/* ../features/ui/src/main/resources/ui-ext/ ",
    "preview": "vite build --mode development && vite preview --port 5002",
    "lint": "eslint src --ext .ts,.vue",
    "lint:fix": "eslint src --ext .ts,.vue --fix",
    "test": "vitest run --config vite.config.testing.ts",
    "coverage": "vitest run --config vite.config.testing.ts --coverage"
  },
  "resolutions": {
    "**/then-request/form-data": "2.5.6",
    "postcss": "^8.4.31",
    "nanoid": "^3.3.8",
    "braces": "^3.0.3",
    "json5": "^2.2.3",
    "flatted": "^3.4.2",
    "decode-uri-component": "0.2.1",
    "js-yaml": "^4.1.1",
    "@babel/traverse": "^7.23.2"
  },
  "dependencies": {
    "@primevue/themes": "^4.5.4",
    "axios": "^0.32.0",
    "date-fns": "^2.29.1",
    "dompurify": "^3.4.10",
    "lodash": "^4.17.23",
    "primevue": "^4.5.5",
    "sass": "^1.101.0",
    "sass-loader": "^13.0.2",
    "vite-plugin-externals": "^0.5.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.7",
    "@types/lodash": "^4.14.181",
    "@types/node": "^18.6.4",
    "@typescript-eslint/eslint-plugin": "^5.32.0",
    "@typescript-eslint/parser": "^5.32.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^9.1.0",
    "eslint": "^8.21.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.1.1",
    "eslint-plugin-vue-scoped-css": "^2.2.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "pinia": "^2.0.17",
    "prettier": "^2.7.1",
    "typescript": "~5.5.4",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
